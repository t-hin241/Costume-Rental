# Copy to .env (git-ignored) and fill in real values locally. Never commit
# real credentials.

# Application database (runtime role: least privilege, not a superuser).
DATABASE_URL=postgres://webee:changeme@localhost:5433/webee_rentor?sslmode=disable

# Integration tests: a role allowed to CREATE DATABASE. Each test package
# creates and drops its own throwaway database. Unset = tests are skipped.
TEST_DATABASE_URL=postgres://webee_test:changeme@localhost:5433/postgres?sslmode=disable

# HTTP API (cmd/server).
HTTP_ADDR=:8080
# true in production (HTTPS only). false only for local plain-HTTP development.
HTTP_COOKIE_SECURE=true
# Frontend origins of the same site allowed to call the API with cookies
# (CORS allowlist + CSRF trust), comma-separated. Empty = same origin only.
HTTP_TRUSTED_ORIGINS=
# Reverse proxies (CIDR or IP, comma-separated) whose X-Forwarded-For is
# trusted for the client address. Empty = use the TCP peer address.
HTTP_TRUSTED_PROXIES=
HTTP_REQUEST_TIMEOUT=15s

# Uploaded product images (decision D38). A folder outside any web root, on a
# volume that survives restarts and is part of the backups. The server refuses
# to start if it cannot write there.
MEDIA_DIR=./data/media
# Largest upload in bytes (5 MiB).
MEDIA_MAX_BYTES=5242880

# Authentication (decisions D23 and D24).
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_CUSTOMER_SESSION_TTL=168h
AUTH_CUSTOMER_SESSION_IDLE=24h
AUTH_STAFF_SESSION_TTL=12h
AUTH_STAFF_SESSION_IDLE=30m
AUTH_RESET_TOKEN_TTL=30m
AUTH_EMAIL_VERIFY_TTL=24h
AUTH_MFA_CHALLENGE_TTL=5m
AUTH_MFA_ISSUER=Webee Rentor
# Encrypts TOTP secrets at rest: 32 random bytes, base64. Generate your own
# with `openssl rand -base64 32`; never reuse this placeholder. Losing or
# changing it invalidates every enrolled authenticator.
AUTH_MFA_ENCRYPTION_KEY=changeme
# Concurrent Argon2id hashes (each holds ~19 MiB). Default: number of CPUs.
AUTH_HASH_CONCURRENCY=4

# Frontend base URL used in emailed links (https; http only when
# HTTP_COOKIE_SECURE=false). Pages: /verify-email, /reset-password,
# /forgot-password, /login; the token is in the URL fragment.
APP_BASE_URL=http://localhost:3000
SHOP_NAME=Webee Rental
# Shown on the storefront by GET /store/info. All optional.
SHOP_ADDRESS=
SHOP_PHONE=
SHOP_EMAIL=
SHOP_HOURS=
SHOP_PAYMENT_INSTRUCTIONS=

# Outgoing email (SMTP submission). SMTP_TLS: starttls (587), tls (465), or
# none for a local catcher such as Mailpit/MailHog (development only, no
# credentials).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=none
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.test
SMTP_FROM_NAME=Webee Rentor

# Local Docker stack (compose.yaml). Generate each with `openssl rand -hex 24`:
# the password goes into a URL, so keep it hex. The database volume keeps these
# from its first start: changing them later needs docker compose down -v.
POSTGRES_PASSWORD=changeme
WEBEE_DB_PASSWORD=changeme

# Public stack on a server (compose.production.yaml): its settings, starting
# with PUBLIC_HOST (your public IP or domain), live in .env.production. Template
# and runbook: deploy/production/env.example and deploy/production/README.md.

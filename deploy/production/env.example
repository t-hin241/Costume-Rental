# Public stack settings and secrets (compose.production.yaml). On the server,
# copy to .env.production at the repository root (git-ignored), chmod 600, and
# fill in values generated for this server only: never reuse local or staging
# secrets. Every value below is a fake placeholder.
#
# Values containing $ or spaces must be in single quotes, otherwise docker
# compose tries to expand them.

# Public address of the site, WITHOUT https:// and without a port or path
# (decision P-02). Either your public IPv4 address (the router's WAN address,
# which must not be a private or carrier-grade NAT address) or a domain name
# whose A record points at it. Emailed links, the CSRF origin and the TLS
# certificate are all built from it. 203.0.113.10 is a documentation address.
PUBLIC_HOST=203.0.113.10

# ACME directory. Leave empty for Let's Encrypt production. While trying the
# router/firewall setup for the first time, use the staging CA so failed
# attempts do not hit the production rate limits (the browser will then warn
# about an untrusted certificate, which is expected):
#   ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
# Afterwards empty it again and run: sh deploy/production/dc down caddy &&
# docker volume rm webee-production_caddy-data && sh deploy/production/dc up -d
ACME_CA=

# X-Robots-Tag on every response (decision P-06). Demo: keep it out of search
# engines. Set to all when the site goes live with real customers.
ROBOTS_TAG='noindex, nofollow'

# Database (each: openssl rand -hex 24; hex because it goes into a URL).
# The database volume keeps them from its first start: changing them later
# needs ALTER ROLE, or `deploy/production/dc down -v`, which deletes all data.
POSTGRES_PASSWORD=replace-with-48-hex-characters
WEBEE_DB_PASSWORD=replace-with-48-hex-characters

# Encrypts TOTP secrets at rest: openssl rand -base64 32. Losing or changing
# it invalidates every enrolled authenticator.
AUTH_MFA_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32-output=
AUTH_MFA_ISSUER='Webee Rental'

# Outgoing email (decision P-05). TLS is mandatory: the server refuses
# SMTP_TLS=none with secure cookies. Examples (pick one):
#   Mailtrap Email Sandbox (catches every mail, nothing reaches real inboxes):
#     sandbox.smtp.mailtrap.io, 587, starttls, inbox username/password
#   Gmail with an App Password (2-step verification on, ~500 mails/day):
#     smtp.gmail.com, 587, starttls, the address, the 16-letter app password;
#     SMTP_FROM must be that same address
#   A transactional provider (Brevo, Mailjet, SES...): their SMTP relay
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME='Webee Rental'

# Storefront details (GET /store/info). Demo: fake data only.
SHOP_NAME='Webee Rental'
SHOP_ADDRESS=
SHOP_PHONE=
SHOP_EMAIL=
SHOP_HOURS=
SHOP_PAYMENT_INSTRUCTIONS=

# Backups (deploy/production/backup.sh, decision P-07).
# Local folder (default ~/webee-backups); BACKUP_KEEP backups are kept there.
BACKUP_DIR=
BACKUP_KEEP=7
# Optional rclone remote:bucket for a copy off this server (another disk, R2,
# S3, Google Drive...). Empty = local only, and a warning in the backup log.
BACKUP_RCLONE_REMOTE=

# Staging secrets and settings. On the VM, copy to .env.staging at the
# repository root (git-ignored), chmod 600, and fill in values generated for
# staging only: never reuse local or production secrets. Every value below is a
# fake placeholder.
#
# Values containing $ or spaces must be in single quotes, otherwise docker
# compose tries to expand them.

# Public host name of the staging-edge Worker, without https:// (decision S-02).
# Emailed links and the CSRF origin are built from it.
STAGING_HOST=webee-staging-edge.example-account.workers.dev

# Connector token of the Cloudflare Tunnel (Zero Trust > Networks > Tunnels >
# the tunnel > install connector: the long value after --token).
CLOUDFLARE_TUNNEL_TOKEN=replace-with-the-tunnel-token

# Database (each: openssl rand -hex 24; hex because it goes into a URL).
# The database volume keeps them from its first start: changing them later
# needs `deploy/staging/dc down -v`, which deletes the staging data.
POSTGRES_PASSWORD=replace-with-48-hex-characters
WEBEE_DB_PASSWORD=replace-with-48-hex-characters

# Encrypts TOTP secrets at rest: openssl rand -base64 32. Losing or changing
# it invalidates every enrolled authenticator.
AUTH_MFA_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32-output=

# Outgoing email (decision S-04: Mailtrap Email Sandbox, which catches every
# message). Take host, port, username and password from the inbox's SMTP
# settings. TLS is mandatory here: the server refuses SMTP_TLS=none with
# secure cookies.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USERNAME=replace-with-mailtrap-username
SMTP_PASSWORD=replace-with-mailtrap-password
SMTP_FROM=no-reply@example.test
SMTP_FROM_NAME='Webee Rental (staging)'

# Storefront details (GET /store/info). Fake data only on staging.
SHOP_NAME='Webee Rental (staging)'
SHOP_ADDRESS=
SHOP_PHONE=
SHOP_EMAIL=
SHOP_HOURS=
SHOP_PAYMENT_INSTRUCTIONS=

# Backups (deploy/staging/backup.sh, decision S-07).
# Local folder (default ~/webee-backups); seven backups are kept locally.
BACKUP_DIR=
BACKUP_KEEP=7
# rclone remote and bucket for the off-VM copy in R2. The staging-edge Worker
# alerts when the newest object there is older than BACKUP_MAX_AGE_HOURS, so
# leaving this empty means a stale-backup alert every day.
BACKUP_RCLONE_REMOTE=r2:webee-staging-backups
